# Supply-chain gates: no install scripts, nothing published after the pin date (mirrors uv's
# exclude-newer), exact versions only. The date admits vite 8.2.4, vitest 5.0.3 and undici 8.12.2,
# the first releases fixing their open security advisories.
ignore-scripts=true
before=2026-10-16T00:00:00Z
save-exact=true
audit=false
fund=false
