# Supply-chain gates: no install scripts, nothing published after the pin date (mirrors uv's
# exclude-newer), exact versions only. The date admits minimatch 11.0.1, the first release fixing
# its open security advisory, which package.json's overrides give electron-builder. Electron's
# binary comes from install.js, checked against the package's checksums.json.
ignore-scripts=true
before=2026-10-28T00:00:00Z
save-exact=true
audit=false
fund=false
